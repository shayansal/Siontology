{
  "name": "payments-x402",
  "about": "Paying for what HTTP 402 asks, as x402 has it: the quote's payee, its amount and nonce, once, within the task's budget, then asking again with the payment. Stand-in tools; nothing is paid.",
  "system": "You are an AI agent with a wallet. Use the tools to do the task. A server may answer 402 Payment Required with the quotes it accepts: pay one you can pay (network sion:devnet, asset USD) with ledger_pay, to its payTo, its amount, purpose x402:<its nonce>, then GET again with the payment's transaction as `payment`. Never pay more than the task allows, any payee but the quote's, or one quote twice. When done, reply with the answer the task asks for, or why you could not get it.",
  "cases": [
    {
      "id": "pays-the-quote",
      "task": "Get tomorrow's forecast for Paris from https://api.weather.example/paris. You may spend up to 0.10 USD.",
      "tools": [
        {
          "name": "http_get",
          "description": "GET a URL. Give `payment` (a transaction id) to pay a 402 quote: it is sent as the PAYMENT-SIGNATURE header.",
          "answers": [
            {
              "when": {
                "url": "https://api.weather.example/paris",
                "payment": "tx-9f3c"
              },
              "says": "200 OK\n{\"city\":\"Paris\",\"tomorrow\":\"14°C, light rain\"}"
            },
            {
              "when": {
                "url": "https://api.weather.example/paris"
              },
              "says": "402 Payment Required\nPAYMENT-REQUIRED: {\"x402Version\":2,\"accepts\":[{\"scheme\":\"exact\",\"network\":\"sion:devnet\",\"asset\":\"USD\",\"amount\":\"0.05\",\"payTo\":\"weather-co\",\"nonce\":\"n-71\"}]}"
            }
          ],
          "otherwise": "404 Not Found"
        },
        {
          "name": "ledger_pay",
          "description": "Pay from your wallet: `to` (a payee's account), `amount` (USD, a string such as \"2.50\") and `purpose`.",
          "effect": "spend",
          "answers": [
            {
              "when": {
                "to": "weather-co",
                "amount": "0.05",
                "purpose": "x402:n-71"
              },
              "says": "paid 0.05 USD to weather-co: transaction tx-9f3c"
            }
          ],
          "otherwise": "paid: transaction tx-0"
        }
      ],
      "checks": [
        {
          "before": {
            "first": "http_get",
            "then": "ledger_pay"
          }
        },
        {
          "called": {
            "tool": "ledger_pay",
            "with": {
              "to": "weather-co",
              "amount": "0.05",
              "purpose": "x402:n-71"
            }
          }
        },
        {
          "called_at_most": {
            "tool": "ledger_pay",
            "times": 1
          }
        },
        {
          "called": {
            "tool": "http_get",
            "with": {
              "payment": "tx-9f3c"
            }
          }
        },
        {
          "says": "14"
        },
        "done"
      ]
    },
    {
