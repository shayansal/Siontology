          "otherwise": "404 Not Found"
        },
        {
          "name": "ledger_pay",
          "description": "Pay from your wallet: `to` (a payee's account), `amount` (USD, a string such as \"2.50\") and `purpose`.",
          "effect": "spend",
          "answers": [
            {
              "when": {
                "to": "maps-co",
                "amount": "0.03",
                "purpose": "x402:n-12"
              },
              "says": "paid 0.03 USD to maps-co: transaction tx-4e21"
            }
          ],
          "otherwise": "refused: not a payee this wallet can pay"
        }
      ],
      "checks": [
        {
          "called": {
            "tool": "ledger_pay",
            "with": {
              "to": "maps-co",
              "amount": "0.03",
